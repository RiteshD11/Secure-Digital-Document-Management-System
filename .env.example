# ==============================================================================
# SECURE DIGITAL DMS (NYAYASETU / NYAYAVAULT) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# FastAPI AI/ML & Biometrics Microservice Base URL
# Example: http://10.10.11.42:8000 or http://localhost:8000
FASTAPI_BASE_URL=http://10.10.11.42:8000
FASTAPI_CONNECT_TIMEOUT_MS=5000
FASTAPI_READ_TIMEOUT_MS=15000

# Database Configuration (Placeholder template - NEVER commit real credentials)
databaseurl=jdbc:mysql://localhost:3306/security_management
databaseusername=root
databasepassword=your_db_password_here

# JWT Secret Key (HMAC SHA-256 256-bit secret key)
jwtSecretKey=your_256_bit_jwt_secret_key_placeholder_here

# Mail Service (SMTP Configuration)
mailUsername=your_email@gmail.com
mailPassword=your_smtp_app_password_here

# Object Storage (MinIO S3 - Optional)
dms.minio.endpoint=http://localhost:9000
dms.minio.accessKey=minioadmin
dms.minio.secretKey=minioadmin
dms.minio.bucketName=secure-dms-documents
